{
  "name": "poe-batonga",
  "private": true,
  "version": "0.1.73",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev --additional-watch-folders ../data",
    "desktop:build": "tauri build --no-bundle",
    "layouts:update": "scripts/update-layouts.sh",
    "icons:update": "scripts/update-icons.sh",
    "triggers:check": "scripts/check-triggers.sh",
    "vision:experiment": "node experiments/map-reading/run.mjs",
    "vision:test": "node --test experiments/map-reading/baseline.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.1"
  }
}
