{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Batonga Overlay Test",
  "version": "0.1.0",
  "identifier": "com.poebatonga.overlaytest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay", "title": "Batonga · Overlay",
        "url": "index.html?view=overlay",
        "width": 550, "height": 360, "x": 20, "y": 170,
        "transparent": true, "backgroundColor": "#00000000",
        "decorations": false, "shadow": false, "alwaysOnTop": true,
        "skipTaskbar": true, "resizable": true,
        "focus": false, "focusable": false, "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
